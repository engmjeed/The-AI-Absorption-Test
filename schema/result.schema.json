{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/engmjeed/ai-product-survival-test/blob/main/schema/result.schema.json",
  "title": "The AI Absorption Test Result",
  "description": "Structured Full-mode output for The AI Absorption Test v0.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework_version",
    "product_summary",
    "observed_facts",
    "assumptions",
    "score",
    "verdict",
    "confidence",
    "dimensions",
    "why",
    "biggest_absorption_risk",
    "strongest_defensible_asset",
    "survival_design",
    "build_decision",
    "decisive_question"
  ],
  "properties": {
    "framework_version": {"const": "0.2"},
    "product_summary": {"type": "string", "minLength": 1},
    "observed_facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "verdict": {
      "type": "string",
      "enum": ["grows_with_ai", "needs_stronger_defensibility", "at_risk_of_absorption", "likely_to_be_absorbed"]
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "weight", "weighted_score", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "absorption_resistance",
              "ai_growth_alignment",
              "compounding_assets",
              "workflow_depth",
              "replication_resistance",
              "ai_created_problem_tailwind",
              "model_independence",
              "defensive_path"
            ]
          },
          "score": {"type": "integer", "minimum": 0, "maximum": 4},
          "weight": {"type": "integer", "enum": [5, 10, 15, 20]},
          "weighted_score": {"type": "number", "minimum": 0, "maximum": 20},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "why": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "biggest_absorption_risk": {"type": "string", "minLength": 1},
    "strongest_defensible_asset": {"type": "string", "minLength": 1},
    "survival_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absorbable_shell",
        "defensible_core",
        "value_migration",
        "reality_anchor",
        "workflow_evolution",
        "ai_distribution_path",
        "time_to_moat",
        "redesign_recommendation"
      ],
      "properties": {
        "absorbable_shell": {"type": "array", "items": {"type": "string"}},
        "defensible_core": {"type": "array", "items": {"type": "string"}},
        "value_migration": {"type": "string", "minLength": 1},
        "reality_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "anchors", "explanation"],
          "properties": {
            "status": {"type": "string", "enum": ["strong", "partial", "weak", "none", "unknown"]},
            "anchors": {"type": "array", "items": {"type": "string"}},
            "explanation": {"type": "string"}
          }
        },
        "workflow_evolution": {"type": "string", "minLength": 1},
        "ai_distribution_path": {"type": "string", "minLength": 1},
        "time_to_moat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_defensible_asset", "milestone_or_time", "prerequisite", "risk_before_moat"],
          "properties": {
            "first_defensible_asset": {"type": "string", "minLength": 1},
            "milestone_or_time": {"type": "string", "minLength": 1},
            "prerequisite": {"type": "string", "minLength": 1},
            "risk_before_moat": {"type": "string", "minLength": 1}
          }
        },
        "redesign_recommendation": {"type": "string", "minLength": 1}
      }
    },
    "build_decision": {
      "type": "string",
      "enum": ["build_as_is", "build_and_strengthen_moat", "validate_defensibility_first", "redesign_before_building", "do_not_build_as_is"]
    },
    "decisive_question": {"type": "string", "minLength": 1}
  }
}
