{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/engmjeed/ai-product-survival-test/schema/result.schema.json",
  "title": "AI Product Survival Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_summary",
    "assumptions",
    "score",
    "verdict",
    "confidence",
    "dimensions",
    "why",
    "likely_to_be_absorbed",
    "defensible_assets",
    "best_modification",
    "decisive_question"
  ],
  "properties": {
    "product_summary": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": [
        "grows_with_ai",
        "needs_stronger_defensibility",
        "at_risk_of_absorption",
        "likely_to_be_absorbed"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "weight", "weighted_score", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "absorption_resistance",
              "ai_tailwind",
              "wrapper_dependence",
              "compounding_assets",
              "workflow_depth",
              "replication_resistance",
              "ai_expanded_problem",
              "model_independence"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "weight": {
            "type": "integer",
            "enum": [5, 10, 15, 25]
          },
          "weighted_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 25
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "why": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "likely_to_be_absorbed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "defensible_assets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "best_modification": {
      "type": "string",
      "minLength": 1
    },
    "defensive_path": {
      "type": "string"
    },
    "decisive_question": {
      "type": "string",
      "minLength": 1
    }
  }
}
