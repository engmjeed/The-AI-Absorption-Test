{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/engmjeed/ai-absorption-test/blob/main/schema/result.schema.json",
  "title": "The AI Absorption Test Result",
  "description": "Structured output for The AI Absorption Test framework.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_summary",
    "assumptions",
    "score",
    "verdict",
    "confidence",
    "dimensions",
    "why",
    "likely_to_be_absorbed",
    "defensible_assets",
    "best_modification",
    "decisive_question"
  ],
  "properties": {
    "product_summary": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"type": "string"}
    },
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "verdict": {
      "type": "string",
      "enum": ["grows_with_ai", "needs_stronger_defensibility", "at_risk_of_absorption", "likely_to_be_absorbed"]
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "dimensions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "weight", "weighted_score", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "absorption_resistance",
              "ai_growth_alignment",
              "compounding_assets",
              "workflow_depth",
              "replication_resistance",
              "ai_created_problem_tailwind",
              "model_independence",
              "defensive_path"
            ]
          },
          "score": {"type": "integer", "minimum": 0, "maximum": 4},
          "weight": {"type": "integer", "enum": [5, 10, 15, 20]},
          "weighted_score": {"type": "number", "minimum": 0, "maximum": 20},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "why": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "likely_to_be_absorbed": {"type": "array", "items": {"type": "string"}},
    "defensible_assets": {"type": "array", "items": {"type": "string"}},
    "best_modification": {"type": "string", "minLength": 1},
    "decisive_question": {"type": "string", "minLength": 1}
  }
}
